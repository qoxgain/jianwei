{
  "schema": "b2u1-prospective-development-routes-v1",
  "purpose": "Separate motif reuse from dynamic forecasting; no semantic action accuracy or formal research admission",
  "authored_after_observing_old_development_results": true,
  "reject_baseline_catalog_sources": true,
  "minimum_sessions": 3,
  "minimum_capture_dates": 2,
  "roles": [
    "fit",
    "calibration",
    "confirmation"
  ],
  "minimum_duration_ms": 240000,
  "maximum_duration_ms": 480000,
  "primary_feature": "frame_difference",
  "secondary_features": [
    "global_r3d",
    "hands_r3d",
    "interaction_r3d",
    "local_r3d",
    "block_motion",
    "hands_motion",
    "motion_fusion",
    "local_fusion",
    "background_motion",
    "background_r3d"
  ],
  "frozen_algorithm": {
    "window_ms": 2000,
    "sample_fps": 8,
    "forecast_history": 6,
    "forecast_lags": [
      2,
      4
    ],
    "motif_lengths": [
      2,
      4,
      6
    ],
    "seeds": [
      11,
      23,
      37,
      53,
      71
    ],
    "ridge_lambda": 1.0
  },
  "route_a": {
    "question": "Recurring anonymous feature motifs in independent new sessions, not future-feature MSE",
    "minimum_occurrences_per_session": 3,
    "coverage_min": 0.05,
    "coverage_max": 0.85,
    "noise_agreement_min": 0.8,
    "roi_agreement_min": 0.7,
    "coverage_excess_over_all_time_shuffles_min": 0.1,
    "coverage_excess_over_background_min": 0.1,
    "block_shuffle_role": "report content-preserving control, not a motif-existence rejection gate",
    "fixed_window_role": "report boundary stability; fixed-window invariance is not evidence of learned actions",
    "future_prediction_required": false
  },
  "route_b": {
    "question": "Frozen Ridge reduces unseen-session feature forecast error beyond persistence and training mean",
    "primary_predictor": "ridge",
    "minimum_pairs_each_lag": 30,
    "gain_vs_persistence_min": 0.05,
    "gain_vs_trainmean_min": 0.05,
    "must_exceed_all_shuffled_target_ridge_controls": true,
    "history_ablation_gain_for_history_claim": 0.02,
    "history_ablation_is_not_retraining": true,
    "anonymous_motif_discovery_required": false
  },
  "threshold_status": "prospective fixed feasibility hypotheses, not empirically validated acceptance thresholds",
  "old_gate_must_remain_unchanged": true,
  "old_failed_candidates_promoted": false,
  "production_activation": false,
  "formal_test_access": false,
  "p04_admitted": false,
  "frozen_unlabeled_settings": {
    "enabled": true,
    "window_ms": 2000,
    "sample_fps": 8,
    "fit_fraction": 0.5,
    "calibration_fraction": 0.25,
    "purge_ms": 2000,
    "projection_dim": 8,
    "change_quantile": 0.8,
    "scales": [
      1,
      2,
      4
    ],
    "min_segment_windows": 2,
    "max_segment_windows": 20,
    "fixed_segment_windows": 4,
    "dp_penalty_multiplier": 1.0,
    "motif_lengths": [
      2,
      4,
      6
    ],
    "min_repeats": 3,
    "max_prototypes": 8,
    "motif_neighbor_quantile": 0.35,
    "motif_radius_factor": 1.2,
    "min_shape_rms": 0.15,
    "context_weight": 0.25,
    "activity_quantile": 0.25,
    "max_profile_windows": 512,
    "seeds": [
      11,
      23,
      37,
      53,
      71
    ],
    "noise_sigma": 0.05,
    "background_mix": 0.3,
    "boundary_tolerance_ms": 1000,
    "forecast_history": 6,
    "forecast_lags": [
      2,
      4
    ],
    "ridge_lambda": 1.0,
    "retrieval_k": 3,
    "min_gate_stability": 0.65,
    "min_gate_null_margin": 0.02,
    "min_gate_prediction_gain": 0.0,
    "max_gate_coverage": 0.9,
    "formal_research_access": false,
    "production_updates": false
  },
  "roi_selection": "Fit-source preview only; lock full ROI/feature contract and model receipt before calibration capture",
  "model_freeze_must_precede_calibration_capture": true,
  "sampling_sensitivity": {
    "primary": "2s/8fps/1s-stride",
    "secondary": "2s/4fps separately fitted and separately frozen parent; no cross-space prototype-ID matching",
    "decision_scope": "Primary decision remains 8fps; without secondary evidence no sampling-robustness claim",
    "execute_with": "existing run_b2u/query commands under a separately recorded 4fps runtime, before any confirmation selection"
  }
}
