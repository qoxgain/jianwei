{
  "$defs": {
    "LabelProvenance": {
      "additionalProperties": false,
      "properties": {
        "tier": {
          "enum": [
            "unlabeled",
            "teacher_candidate",
            "weak_verified",
            "human_verified"
          ],
          "title": "Tier",
          "type": "string"
        },
        "producer_version": {
          "minLength": 1,
          "title": "Producer Version",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        }
      },
      "required": [
        "tier",
        "producer_version",
        "evidence_ids"
      ],
      "title": "LabelProvenance",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "tenant_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
      "title": "Tenant Id",
      "type": "string"
    },
    "scene_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
      "title": "Scene Id",
      "type": "string"
    },
    "contract_version": {
      "const": "3.1",
      "title": "Contract Version",
      "type": "string"
    },
    "episode_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
      "title": "Episode Id",
      "type": "string"
    },
    "time_domain_id": {
      "default": "legacy",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
      "title": "Time Domain Id",
      "type": "string"
    },
    "source_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
      "title": "Source Id",
      "type": "string"
    },
    "source_video_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
      "title": "Source Video Id",
      "type": "string"
    },
    "source_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Source Hash",
      "type": "string"
    },
    "entity_id": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Entity Id"
    },
    "pts_start_ms": {
      "minimum": 0,
      "title": "Pts Start Ms",
      "type": "integer"
    },
    "pts_end_ms": {
      "exclusiveMinimum": 0,
      "title": "Pts End Ms",
      "type": "integer"
    },
    "context": {
      "patternProperties": {
        "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "title": "Context",
      "type": "object"
    },
    "observation_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
      "title": "Observation Id",
      "type": "string"
    },
    "kind": {
      "const": "visual_observation",
      "title": "Kind",
      "type": "string"
    },
    "action_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Action Id"
    },
    "observed_status": {
      "enum": [
        "UNKNOWN",
        "REVIEW_REQUIRED",
        "VERIFIED"
      ],
      "title": "Observed Status",
      "type": "string"
    },
    "available_at_pts_ms": {
      "minimum": 0,
      "title": "Available At Pts Ms",
      "type": "integer"
    },
    "provenance": {
      "$ref": "#/$defs/LabelProvenance"
    },
    "knowledge_version": {
      "title": "Knowledge Version",
      "type": "string"
    }
  },
  "required": [
    "tenant_id",
    "scene_id",
    "contract_version",
    "episode_id",
    "source_id",
    "source_video_id",
    "source_hash",
    "entity_id",
    "pts_start_ms",
    "pts_end_ms",
    "context",
    "observation_id",
    "kind",
    "action_id",
    "observed_status",
    "available_at_pts_ms",
    "provenance",
    "knowledge_version"
  ],
  "title": "ActivityObservation",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
