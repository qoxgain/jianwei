{
  "$defs": {
    "DatasetSource": {
      "additionalProperties": false,
      "properties": {
        "source_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Source Sha256",
          "type": "string"
        },
        "root_source_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Root Source Sha256",
          "type": "string"
        },
        "parent_source_sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Source Sha256"
        },
        "relation": {
          "enum": [
            "original",
            "clip",
            "transcode",
            "other_derived"
          ],
          "title": "Relation",
          "type": "string"
        },
        "capture_session_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Capture Session Id"
        },
        "camera_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Camera Id"
        },
        "view_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "View Id"
        },
        "captured_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Captured At"
        },
        "split": {
          "default": "unassigned",
          "enum": [
            "unassigned",
            "train",
            "calibration",
            "test"
          ],
          "title": "Split",
          "type": "string"
        },
        "provenance_review": {
          "$ref": "#/$defs/SourceReview"
        },
        "near_duplicate_review": {
          "$ref": "#/$defs/SourceReview"
        }
      },
      "required": [
        "source_sha256",
        "root_source_sha256",
        "relation"
      ],
      "title": "DatasetSource",
      "type": "object"
    },
    "DuplicateReview": {
      "additionalProperties": false,
      "properties": {
        "left_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Left Sha256",
          "type": "string"
        },
        "right_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Right Sha256",
          "type": "string"
        },
        "resolution": {
          "default": "pending",
          "enum": [
            "pending",
            "same_session",
            "independent"
          ],
          "title": "Resolution",
          "type": "string"
        },
        "reviewer": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewer"
        },
        "reviewed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewed At"
        },
        "notes": {
          "anyOf": [
            {
              "maxLength": 2000,
              "minLength": 5,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        }
      },
      "required": [
        "left_sha256",
        "right_sha256"
      ],
      "title": "DuplicateReview",
      "type": "object"
    },
    "SourceReview": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "default": "pending",
          "enum": [
            "pending",
            "confirmed"
          ],
          "title": "Status",
          "type": "string"
        },
        "reviewer": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewer"
        },
        "reviewed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewed At"
        },
        "method": {
          "anyOf": [
            {
              "maxLength": 1000,
              "minLength": 5,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Method"
        },
        "notes": {
          "anyOf": [
            {
              "maxLength": 2000,
              "minLength": 5,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        }
      },
      "title": "SourceReview",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "manifest_version": {
      "const": "p031-sources-v1",
      "default": "p031-sources-v1",
      "title": "Manifest Version",
      "type": "string"
    },
    "dataset_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
      "title": "Dataset Id",
      "type": "string"
    },
    "tenant_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
      "title": "Tenant Id",
      "type": "string"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/DatasetSource"
      },
      "maxItems": 1000,
      "minItems": 1,
      "title": "Sources",
      "type": "array"
    },
    "duplicate_reviews": {
      "items": {
        "$ref": "#/$defs/DuplicateReview"
      },
      "maxItems": 10000,
      "title": "Duplicate Reviews",
      "type": "array"
    }
  },
  "required": [
    "dataset_id",
    "tenant_id",
    "sources"
  ],
  "title": "DatasetManifest",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
