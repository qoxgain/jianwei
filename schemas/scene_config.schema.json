        },
        "empirical_prior_weight_max": {
          "maximum": 0.5,
          "minimum": 0,
          "title": "Empirical Prior Weight Max",
          "type": "number"
        },
        "allow_cross_tenant": {
          "const": false,
          "title": "Allow Cross Tenant",
          "type": "boolean"
        },
        "train_split": {
          "const": "train",
          "title": "Train Split",
          "type": "string"
        },
        "train_adapters": {
          "items": {
            "enum": [
              "temporal_head",
              "tsm",
              "yolo_detector"
            ],
            "type": "string"
          },
          "title": "Train Adapters",
          "type": "array"
        },
        "require_verified_boxes_for_detector": {
          "const": true,
