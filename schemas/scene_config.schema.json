          "type": "integer"
        },
        "learning_rate": {
          "exclusiveMinimum": 0,
          "title": "Learning Rate",
          "type": "number"
        },
        "ridge_l2": {
          "exclusiveMinimum": 0,
          "title": "Ridge L2",
          "type": "number"
        },
        "dirichlet_alpha": {
          "exclusiveMinimum": 0,
          "title": "Dirichlet Alpha",
          "type": "number"
        },
        "pseudo_label_fraction_max": {
          "maximum": 1,
          "minimum": 0,
          "title": "Pseudo Label Fraction Max",
