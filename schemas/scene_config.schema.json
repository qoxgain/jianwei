{
  "$defs": {
    "ContextField": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "string",
            "integer",
            "number",
            "boolean"
          ],
          "title": "Type",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        }
      },
      "required": [
        "type",
        "description"
      ],
      "title": "ContextField",
      "type": "object"
    },
    "DatasetManifest": {
      "additionalProperties": false,
      "properties": {
        "manifest_version": {
          "const": "p031-sources-v1",
          "default": "p031-sources-v1",
          "title": "Manifest Version",
          "type": "string"
        },
        "dataset_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
          "title": "Dataset Id",
          "type": "string"
        },
        "tenant_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
          "title": "Tenant Id",
          "type": "string"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/DatasetSource"
          },
          "maxItems": 1000,
          "minItems": 1,
          "title": "Sources",
          "type": "array"
        },
        "duplicate_reviews": {
          "items": {
            "$ref": "#/$defs/DuplicateReview"
          },
          "maxItems": 10000,
          "title": "Duplicate Reviews",
          "type": "array"
        }
      },
      "required": [
        "dataset_id",
        "tenant_id",
        "sources"
      ],
      "title": "DatasetManifest",
      "type": "object"
    },
    "DatasetSource": {
      "additionalProperties": false,
      "properties": {
        "source_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Source Sha256",
          "type": "string"
        },
        "root_source_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Root Source Sha256",
          "type": "string"
        },
        "parent_source_sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Source Sha256"
        },
        "relation": {
          "enum": [
            "original",
            "clip",
            "transcode",
            "other_derived"
          ],
          "title": "Relation",
          "type": "string"
        },
        "capture_session_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Capture Session Id"
        },
        "camera_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Camera Id"
        },
        "view_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "View Id"
        },
        "captured_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Captured At"
        },
        "split": {
          "default": "unassigned",
          "enum": [
            "unassigned",
            "train",
            "calibration",
            "test"
          ],
          "title": "Split",
          "type": "string"
        },
        "provenance_review": {
          "$ref": "#/$defs/SourceReview"
        },
        "near_duplicate_review": {
          "$ref": "#/$defs/SourceReview"
        }
      },
      "required": [
        "source_sha256",
        "root_source_sha256",
        "relation"
      ],
      "title": "DatasetSource",
      "type": "object"
    },
    "Demo": {
      "additionalProperties": false,
      "properties": {
        "seed": {
          "title": "Seed",
          "type": "integer"
        },
        "train_episodes": {
          "minimum": 5,
          "title": "Train Episodes",
          "type": "integer"
        },
        "test_episodes": {
          "minimum": 5,
          "title": "Test Episodes",
          "type": "integer"
        },
        "feature_dim": {
          "minimum": 6,
          "title": "Feature Dim",
          "type": "integer"
        },
        "noise_std": {
          "exclusiveMinimum": 0,
          "title": "Noise Std",
          "type": "number"
        },
        "ridge_l2": {
          "exclusiveMinimum": 0,
          "title": "Ridge L2",
          "type": "number"
        },
        "skip_branch_probability": {
          "maximum": 1,
          "minimum": 0,
          "title": "Skip Branch Probability",
          "type": "number"
        }
      },
      "required": [
        "seed",
        "train_episodes",
        "test_episodes",
        "feature_dim",
        "noise_std",
        "ridge_l2",
        "skip_branch_probability"
      ],
      "title": "Demo",
      "type": "object"
    },
    "DuplicateReview": {
      "additionalProperties": false,
      "properties": {
        "left_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Left Sha256",
          "type": "string"
        },
        "right_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Right Sha256",
          "type": "string"
        },
        "resolution": {
          "default": "pending",
          "enum": [
            "pending",
            "same_session",
            "independent"
          ],
          "title": "Resolution",
          "type": "string"
        },
        "reviewer": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewer"
        },
        "reviewed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewed At"
        },
        "notes": {
          "anyOf": [
            {
              "maxLength": 2000,
              "minLength": 5,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        }
      },
      "required": [
        "left_sha256",
        "right_sha256"
      ],
      "title": "DuplicateReview",
      "type": "object"
    },
    "EpisodePolicy": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "manual_cycle",
            "external_cycle",
            "fixed_window",
            "manual_or_external_cycle",
            "manual_or_fixed_window"
          ],
          "title": "Mode",
          "type": "string"
        },
        "window_seconds": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Window Seconds"
        }
      },
      "required": [
        "mode",
        "window_seconds"
      ],
      "title": "EpisodePolicy",
      "type": "object"
    },
    "Evaluation": {
      "additionalProperties": false,
      "properties": {
        "minimum_gold_events_per_class": {
          "minimum": 1,
          "title": "Minimum Gold Events Per Class",
          "type": "integer"
        },
        "seeds": {
          "items": {
            "type": "integer"
          },
          "minItems": 1,
          "title": "Seeds",
          "type": "array"
        },
        "bootstrap_iterations": {
          "minimum": 100,
          "title": "Bootstrap Iterations",
          "type": "integer"
        },
        "confidence_level": {
          "exclusiveMaximum": 1,
          "exclusiveMinimum": 0.5,
          "title": "Confidence Level",
          "type": "number"
        },
        "required_macro_f1_gain": {
          "maximum": 1,
          "minimum": 0,
          "title": "Required Macro F1 Gain",
          "type": "number"
        },
        "max_old_macro_f1_drop": {
          "maximum": 1,
          "minimum": 0,
          "title": "Max Old Macro F1 Drop",
          "type": "number"
        },
        "max_old_class_f1_drop": {
          "maximum": 1,
          "minimum": 0,
          "title": "Max Old Class F1 Drop",
          "type": "number"
        },
        "gain_ci_lower_min": {
          "title": "Gain Ci Lower Min",
          "type": "number"
        },
        "max_false_alarm_ratio": {
          "minimum": 1,
          "title": "Max False Alarm Ratio",
          "type": "number"
        },
        "max_coverage_drop": {
          "maximum": 1,
          "minimum": 0,
          "title": "Max Coverage Drop",
          "type": "number"
        },
        "online_p95_ms_budget": {
          "minimum": 1,
          "title": "Online P95 Ms Budget",
          "type": "integer"
        },
        "protocol_version": {
          "title": "Protocol Version",
          "type": "string"
        }
      },
      "required": [
        "minimum_gold_events_per_class",
        "seeds",
        "bootstrap_iterations",
        "confidence_level",
        "required_macro_f1_gain",
        "max_old_macro_f1_drop",
        "max_old_class_f1_drop",
        "gain_ci_lower_min",
        "max_false_alarm_ratio",
        "max_coverage_drop",
        "online_p95_ms_budget",
        "protocol_version"
      ],
      "title": "Evaluation",
      "type": "object"
    },
    "GarmentExtension": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "garment_inspection",
          "title": "Type",
          "type": "string"
        },
        "score_base": {
          "title": "Score Base",
          "type": "integer"
        },
        "verified_missing_penalty": {
          "minimum": 0,
          "title": "Verified Missing Penalty",
          "type": "integer"
        },
        "missing_without_evidence": {
          "const": "REVIEW_REQUIRED",
          "title": "Missing Without Evidence",
          "type": "string"
        },
        "separate_rework": {
          "title": "Separate Rework",
          "type": "boolean"
        }
      },
      "required": [
        "type",
        "score_base",
        "verified_missing_penalty",
        "missing_without_evidence",
        "separate_rework"
      ],
      "title": "GarmentExtension",
      "type": "object"
    },
    "IngestionSettings": {
      "additionalProperties": false,
      "properties": {
        "max_upload_bytes": {
          "default": 67108864,
          "maximum": 2147483648,
          "minimum": 1024,
          "title": "Max Upload Bytes",
          "type": "integer"
        },
        "max_expanded_bytes": {
          "default": 134217728,
          "maximum": 2147483648,
          "minimum": 1024,
          "title": "Max Expanded Bytes",
          "type": "integer"
        },
        "max_rows": {
          "default": 100000,
          "maximum": 1000000,
          "minimum": 1,
          "title": "Max Rows",
          "type": "integer"
        },
        "max_duration_seconds": {
          "default": 600,
          "maximum": 86400,
          "minimum": 1,
          "title": "Max Duration Seconds",
          "type": "integer"
        },
        "max_frames": {
          "default": 18000,
          "maximum": 1000000,
          "minimum": 2,
          "title": "Max Frames",
          "type": "integer"
        },
        "max_pixels": {
          "default": 8294400,
          "maximum": 67108864,
          "minimum": 64,
          "title": "Max Pixels",
          "type": "integer"
        },
        "probe_timeout_seconds": {
          "default": 60,
          "maximum": 3600,
          "minimum": 1,
          "title": "Probe Timeout Seconds",
          "type": "integer"
        },
        "decode_width": {
          "default": 160,
          "maximum": 1024,
          "minimum": 16,
          "title": "Decode Width",
          "type": "integer"
        },
        "max_gap_ms": {
          "default": 2000,
          "maximum": 600000,
          "minimum": 1,
          "title": "Max Gap Ms",
          "type": "integer"
        },
        "encoder_input_size": {
          "default": 224,
          "maximum": 1024,
          "minimum": 16,
          "title": "Encoder Input Size",
          "type": "integer"
        },
        "encoder_threads": {
          "default": 1,
          "maximum": 32,
          "minimum": 1,
          "title": "Encoder Threads",
          "type": "integer"
        },
        "worker_poll_seconds": {
          "default": 0.25,
          "exclusiveMinimum": 0,
          "maximum": 60,
          "title": "Worker Poll Seconds",
          "type": "number"
        },
        "quality_luma_min": {
          "default": 4.0,
          "maximum": 255,
          "minimum": 0,
          "title": "Quality Luma Min",
          "type": "number"
        },
        "quality_luma_max": {
          "default": 251.0,
          "maximum": 255,
          "minimum": 0,
          "title": "Quality Luma Max",
          "type": "number"
        },
        "quality_std_min": {
          "default": 2.0,
          "maximum": 128,
          "minimum": 0,
          "title": "Quality Std Min",
          "type": "number"
        }
      },
      "title": "IngestionSettings",
      "type": "object"
    },
    "Learning": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "title": "Enabled",
          "type": "boolean"
        },
        "auto_train": {
          "title": "Auto Train",
          "type": "boolean"
        },
        "auto_evaluate": {
          "title": "Auto Evaluate",
          "type": "boolean"
