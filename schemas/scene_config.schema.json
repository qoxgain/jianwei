        },
        "min_independent_cycles_per_action": {
          "minimum": 1,
          "title": "Min Independent Cycles Per Action",
          "type": "integer"
        },
        "min_audited_events_per_action": {
          "minimum": 1,
          "title": "Min Audited Events Per Action",
          "type": "integer"
        },
        "pseudo_precision_wilson_lower_min": {
